# Copie para apps/api/.env e preencha. Nunca comite o .env (§2.3).
# A API não sobe com variável obrigatória faltando: o erro lista o que falta.

NODE_ENV=development
PORT=3333

# --- Banco (§6) ---
# Postgres local do docker-compose (serviço `db`).
DATABASE_URL=postgresql://chacara:chacara_dev@localhost:5432/chacara
# Banco próprio para os testes de integração (§19). Criado pelo runner se faltar.
DATABASE_URL_TEST=postgresql://chacara:chacara_dev@localhost:5432/chacara_test

# --- Sessão (§10.1) ---
# Mínimo 32 caracteres aleatórios. Gere com:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-32-ou-mais-caracteres-aleatorios
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# --- Endereços ---
# URL pública do SPA, usada nos links dos e-mails.
APP_URL=http://localhost:5173
# Só em desenvolvimento: em produção o SPA chama /api no próprio domínio.
CORS_ORIGIN=http://localhost:5173

# --- E-mail (§17) ---
# `log` imprime assunto e links no console; `smtp` envia de verdade.
MAIL_TRANSPORT=log
# Obrigatória quando MAIL_TRANSPORT=smtp. Para o Gmail, use uma senha de app:
#   smtps://usuario@gmail.com:SENHA_DE_APP@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM=Chácara <no-reply@localhost>

# --- Login com Google (§10.3) ---
# Vazio desliga o login com Google sem quebrar o resto.
GOOGLE_CLIENT_ID=

# --- Seed (§8.2) ---
# Criam o primeiro admin. Sem estas duas, `pnpm db:seed` para com erro claro.
ADMIN_EMAIL=admin@chacara.local
ADMIN_PASSWORD=troque-esta-senha
# `true` popula um catálogo de demonstração para testar o wizard localmente.
SEED_DEMO=true
