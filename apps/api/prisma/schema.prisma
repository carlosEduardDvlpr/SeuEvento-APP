generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ReservationStatus {
  ORCAMENTO
  AGUARDANDO_SINAL
  CONFIRMADO
  CONCLUIDO
  CANCELADO

  @@map("reservation_status")
}

model Client {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @db.VarChar(160)
  phone        String        @unique @db.VarChar(30)
  email        String?       @db.VarChar(255)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  reservations Reservation[]

  @@map("clients")
}

model Reservation {
  id        String            @id @default(uuid()) @db.Uuid
  clientId  String            @map("client_id") @db.Uuid
  checkIn   DateTime          @map("check_in") @db.Date
  checkOut  DateTime          @map("check_out") @db.Date
  guests    Int               @db.SmallInt
  total     Decimal           @db.Decimal(12, 2)
  deposit   Decimal           @default(0) @db.Decimal(12, 2)
  status    ReservationStatus @default(ORCAMENTO)
  notes     String?           @db.Text
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  client    Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@index([checkIn, checkOut], map: "reservations_dates_idx")
  @@index([status], map: "reservations_status_idx")
  @@map("reservations")
}
